{
  "extends": [
    "config:recommended"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "gitIgnoredAuthors": [
    "150874479+elastic-vault-github-plugin-prod[bot]@users.noreply.github.com"
  ],
  "automerge": true,
  "automergeType": "pr",
  "ignorePaths": [
    ".github/workflows/*.lock.yml"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Terraform CLI and hc-install versions pinned in the Buildkite acceptance script",
      "managerFilePatterns": [
        "/^\\.buildkite/acceptance\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\n[A-Z_]+=\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "groupName": "github.com/oapi-codegen dependencies",
      "matchPackageNames": [
        "github.com/oapi-codegen/*"
      ]
    },
    {
      "groupName": "github.com/hashicorp dependencies",
      "matchPackageNames": [
        "github.com/hashicorp/*"
      ]
    }
  ],
  "major": {
    "automerge": false
  }
}
