OWNER = elastic
REPO = terraform-provider-ec
PREFIXED_V = v$(subst -dev,,$(VERSION))

### Release targets

## Tags the current commit as the release commit with $(VERSION) (minus -dev).
tag:
	@ git fetch
ifeq ($(shell git tag -l $(PREFIXED_V)),$(PREFIXED_V))
	@ echo "-> git tag $(PREFIXED_V) already exists, exiting..."
	@ exit 1
endif
ifeq ($(shell git remote -v | grep $(OWNER)/$(REPO)),)
	@ echo "-> git remote 'upstream' is not configured, exiting..."
	@ exit 2
endif
	@ $(eval REMOTE = $(shell git remote -v | grep $(OWNER)/$(REPO)| head -1 | awk '{print $$1}'))
	@ echo "Pushing git tag $(PREFIXED_V) to remote \"$(REMOTE)\"..."
	@ git tag $(PREFIXED_V)
	@ git push -u $(REMOTE) $(PREFIXED_V)

## Creates a snapshot build of the terraform provider.
snapshot:
	@ go tool goreleaser release --clean --snapshot

# GitHub release body is this version's CHANGELOG.md section. GoReleaser's own
# changelog is disabled (.goreleaser.yml); without --release-notes the GitHub
# release is published empty. extract-release-notes.sh fails if the section is
# missing, so we never tag-publish a blank body.
RELEASE_VERSION = $(subst -dev,,$(VERSION))

## Releases a new version of the terraform provider with a matching tag.
release:
	@ $(MAKE) gen VERSION=$(RELEASE_VERSION)
	@ notes=$$(mktemp) && \
		trap 'rm -f "$$notes"' EXIT && \
		./scripts/extract-release-notes.sh $(RELEASE_VERSION) > $$notes && \
		go tool goreleaser release --clean --skip=validate --parallelism=4 --release-notes $$notes

## Builds a new version of the terraform provider with a matching tag without publishing it.
release-no-publish:
	@ $(MAKE) gen VERSION=$(RELEASE_VERSION)
	@ notes=$$(mktemp) && \
		trap 'rm -f "$$notes"' EXIT && \
		./scripts/extract-release-notes.sh $(RELEASE_VERSION) > $$notes && \
		go tool goreleaser release --clean --skip=publish,validate --parallelism=4 --release-notes $$notes

.PHONY: changelog
changelog:
	@ echo "-> Generating changelog..."
	@ ./scripts/generate-changelog.sh
